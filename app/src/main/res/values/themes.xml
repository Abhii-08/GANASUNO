<resources>
    <style name="Theme.Ganasuno" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSurface">@color/browse_surface</item>
        <item name="android:windowBackground">@color/browse_surface</item>
    </style>

    <style name="SettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Theme.Ganasuno.Green" parent="Theme.Ganasuno"><item name="colorPrimary">@color/palette_green</item><item name="colorOnPrimary">@color/palette_on_primary</item></style>
    <style name="Theme.Ganasuno.Orange" parent="Theme.Ganasuno"><item name="colorPrimary">@color/palette_orange</item><item name="colorOnPrimary">@color/palette_on_primary</item></style>
    <style name="Theme.Ganasuno.Pink" parent="Theme.Ganasuno"><item name="colorPrimary">@color/palette_pink</item><item name="colorOnPrimary">@color/palette_on_primary</item></style>
    <style name="Theme.Ganasuno.Red" parent="Theme.Ganasuno"><item name="colorPrimary">@color/palette_red</item><item name="colorOnPrimary">@color/brand_on_primary</item></style>
</resources>
