<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22000000">
    <item>
        <layer-list>
            <item><shape android:shape="rectangle">
                <corners android:radius="17dp" />
                <gradient android:angle="270" android:startColor="#F5FFFFFF" android:centerColor="#DCE8EAEE" android:endColor="#D9D2D6DD" />
                <stroke android:width="1dp" android:color="#55717178" />
            </shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#88FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#18FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
