<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#25FFFFFF">
    <item>
        <layer-list>
            <item><shape android:shape="rectangle">
                <corners android:radius="17dp" />
                <gradient android:angle="270" android:startColor="#CF47474D" android:centerColor="#CF1C1C21" android:endColor="#D0303037" />
                <stroke android:width="1dp" android:color="#55FFFFFF" />
            </shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#12FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
